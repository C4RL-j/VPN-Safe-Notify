<Window x:Class="VpnSafeNotify.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — VPN Safe Notify" Width="520" Height="720" MinWidth="460" MinHeight="510"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,5,0,14" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="5" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="24,21,24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,17">
            <TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="Changes take effect when you select Apply." Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="StatusMessage" AutomationProperties.AutomationId="SettingsMessage" FontSize="12" Foreground="#FFC675" Margin="0,0,0,10" MinHeight="16" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="DefaultsButton" Content="Restore defaults" Background="#2B3952" Foreground="{StaticResource PrimaryText}" Padding="12,9" FontSize="12" HorizontalAlignment="Left" Click="RestoreDefaults_Click" AutomationProperties.AutomationId="SettingsRestoreDefaults" />
                <Button Grid.Column="1" x:Name="ApplyButton" Content="Apply" Padding="18,9" FontSize="13" Click="Apply_Click" AutomationProperties.AutomationId="SettingsApply" />
                <Button Grid.Column="2" Content="Close" Background="#2B3952" Foreground="{StaticResource PrimaryText}" Padding="14,9" FontSize="13" Margin="9,0,0,0" Click="Close_Click" AutomationProperties.AutomationId="SettingsClose" />
            </Grid>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <StackPanel x:Name="DraftPanel">
                    <Border Background="{StaticResource CardBackground}" CornerRadius="10" Padding="16,14" Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock Text="Screen-edge warning" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=RedDurationSlider, Path=Value, StringFormat={}{0:0} s}" FontSize="12" HorizontalAlignment="Right" />
                                <TextBlock Text="Red alert duration · 5–7 seconds" Foreground="{StaticResource SecondaryText}" FontSize="12" />
                            </DockPanel>
                            <Slider x:Name="RedDurationSlider" Minimum="5" Maximum="7" LargeChange="1" AutomationProperties.Name="Red alert duration in seconds" AutomationProperties.AutomationId="SettingsRedDuration" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=RepeatSlider, Path=Value, StringFormat={}{0:0} s}" FontSize="12" HorizontalAlignment="Right" />
                                <TextBlock Text="Repeat interval · 15–300 seconds" Foreground="{StaticResource SecondaryText}" FontSize="12" />
                            </DockPanel>
                            <Slider x:Name="RepeatSlider" Minimum="15" Maximum="300" LargeChange="15" AutomationProperties.Name="Repeat interval in seconds" AutomationProperties.AutomationId="SettingsRepeatInterval" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=ThicknessSlider, Path=Value, StringFormat={}{0:0} DIP}" FontSize="12" HorizontalAlignment="Right" />
                                <TextBlock Text="Border thickness · 24–180 DIP" Foreground="{StaticResource SecondaryText}" FontSize="12" />
                            </DockPanel>
                            <Slider x:Name="ThicknessSlider" Minimum="24" Maximum="180" LargeChange="12" AutomationProperties.Name="Border thickness in DIP" AutomationProperties.AutomationId="SettingsBorderThickness" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:0}%}" FontSize="12" HorizontalAlignment="Right" />
                                <TextBlock Text="Border opacity · 5–65%" Foreground="{StaticResource SecondaryText}" FontSize="12" />
                            </DockPanel>
                            <Slider x:Name="OpacitySlider" Minimum="5" Maximum="65" LargeChange="5" AutomationProperties.Name="Border opacity in percent" AutomationProperties.AutomationId="SettingsBorderOpacity" />
                            <CheckBox x:Name="AllMonitorsCheckBox" Content="Show alerts on all monitors" AutomationProperties.AutomationId="SettingsAllMonitors" />
                            <TextBlock Text="When off, alerts appear on the primary monitor only." Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,5,0,12" />
                            <CheckBox x:Name="UnverifiedCheckBox" Content="Also warn when VPN status is unverified" AutomationProperties.AutomationId="SettingsWarnUnverified" />
                            <TextBlock Text="Unverified stays amber: the available evidence cannot confirm a VPN tunnel." Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBackground}" CornerRadius="10" Padding="16,14" Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock Text="Daily use" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <CheckBox x:Name="SoundCheckBox" Content="Play a warning sound" AutomationProperties.AutomationId="SettingsWarningSound" Margin="0,0,0,11" />
                            <CheckBox x:Name="NotificationsCheckBox" Content="Windows notifications" AutomationProperties.AutomationId="SettingsNotifications" Margin="0,0,0,11" />
                            <CheckBox x:Name="LaunchCheckBox" Content="Launch at Windows sign-in" AutomationProperties.AutomationId="SettingsLaunchAtSignIn" Margin="0,0,0,5" />
                            <TextBlock Text="For your Windows account only. No administrator access is needed." Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,11" />
                            <CheckBox x:Name="MinimizedCheckBox" Content="Start minimized to tray" AutomationProperties.AutomationId="SettingsStartMinimized" />
                            <TextBlock Text="Takes effect the next time the app starts." Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Preview effects · network unchanged" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,1,0,8" />
                <WrapPanel>
                    <Button Content="Preview Red" Background="#442C36" Foreground="#FFB2B8" Padding="13,8" FontSize="12" Click="PreviewRed_Click" Margin="0,0,9,0" AutomationProperties.AutomationId="SettingsPreviewRed" />
                    <Button Content="Preview Green" Background="#243D38" Foreground="#8CE4C4" Padding="13,8" FontSize="12" Click="PreviewGreen_Click" AutomationProperties.AutomationId="SettingsPreviewGreen" />
                </WrapPanel>
                <TextBlock Text="Previews use applied settings. Green means a VPN tunnel was detected; full internet traffic protection remains unverified." Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
