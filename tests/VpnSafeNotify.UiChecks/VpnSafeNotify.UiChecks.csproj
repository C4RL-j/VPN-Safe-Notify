<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationManifest>../../src/VpnSafeNotify/app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/VpnSafeNotify/VpnSafeNotify.csproj" />
    <None Include="../../src/VpnSafeNotify/App.xaml" Link="AppTheme.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
